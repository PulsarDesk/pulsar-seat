{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PulsarSeatManager",
  "mainBinaryName": "pulsar-seat-manager",
  "version": "0.1.0",
  "identifier": "com.pulsardesk.seat.manager",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "license": "GPL-3.0-only",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
