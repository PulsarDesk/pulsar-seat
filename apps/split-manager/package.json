{
  "name": "@pulsar-split/manager",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "tauri": "tauri",
    "installer:msi": "tauri build --bundles msi --config ../../installer/split/tauri.release.conf.json",
    "installer:msi:x64": "tauri build --bundles msi --target x86_64-pc-windows-msvc --config ../../installer/split/tauri.release.conf.json --config ../../installer/split/tauri.x64.conf.json",
    "installer:nsis": "tauri build --bundles nsis --config ../../installer/split/tauri.release.conf.json --config ../../installer/split/tauri.nsis.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.10",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "^31.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
