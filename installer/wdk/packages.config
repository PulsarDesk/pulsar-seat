<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<!--
  Windows SDK + WDK 10.0.28000 from Microsoft's NuGet packages, for CI (drivers and
  credprov jobs) and `ci-local.ps1 -WdkNuGet`. Restored with
    nuget restore installer/wdk/packages.config -PackagesDirectory target/wdk-nuget
  and used only while PULSAR_WDK_NUGET names that folder (Directory.Build.props,
  build-drivers.ps1, build-credprov.ps1). One version for every package: the props file
  reads it from the WDK.x64 line; installer/scripts/wdk-nuget.test.ts checks the rest.
  Same set and version as Microsoft's Windows-driver-samples CI on windows-2025-vs2026.
-->
<packages>
  <package id="Microsoft.Windows.SDK.CPP" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.CPP.x64" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.CPP.arm64" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.WDK.x64" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.WDK.arm64" version="10.0.28000.2526" targetFramework="native" />
</packages>
