From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pulsar Seat <pulsar-seat@invalid>
Date: Tue, 17 Nov 2026 08:26:08 +0300
Subject: [PATCH 6/6] pulsar: build with OpenSSL 4

ASN1_STRING and the subject name returned by X509_get_subject_name() are opaque / const in OpenSSL 4 (MSYS2 ships 4.1): use the accessors and a new X509_NAME. Works with OpenSSL 3 too. SPDX-License-Identifier: GPL-3.0-only
---
 src/crypto.cpp | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/crypto.cpp b/src/crypto.cpp
index c5e236e..58089cd 100644
--- a/src/crypto.cpp
+++ b/src/crypto.cpp
@@ -391,7 +391,12 @@ namespace crypto {
     const ASN1_BIT_STRING *asn1 = nullptr;
     X509_get0_signature(&asn1, nullptr, x.get());
 
-    return {(const char *) asn1->data, (std::size_t) asn1->length};
+    // Accessors instead of struct fields: ASN1_STRING is opaque since OpenSSL 4.
+#if OPENSSL_VERSION_NUMBER >= 0x40100000L
+    return {(const char *) ASN1_STRING_get0_data(asn1), (std::size_t) ASN1_STRING_get_length(asn1)};
+#else
+    return {(const char *) ASN1_STRING_get0_data(asn1), (std::size_t) ASN1_STRING_length(asn1)};
+#endif
   }
 
   std::string rand(std::size_t bytes) {
@@ -461,10 +466,13 @@ namespace crypto {
 
     X509_set_pubkey(x509.get(), pkey.get());
 
-    auto name = X509_get_subject_name(x509.get());
+    // A new name object: X509_get_subject_name() returns a const name since OpenSSL 4.
+    auto name = X509_NAME_new();
     X509_NAME_add_entry_by_txt(name, "CN", MBSTRING_ASC, (const std::uint8_t *) cn.data(), (int) cn.size(), -1, 0);
 
+    X509_set_subject_name(x509.get(), name);
     X509_set_issuer_name(x509.get(), name);
+    X509_NAME_free(name);
     X509_sign(x509.get(), pkey.get(), EVP_sha256());
 
     return {pem(x509), pem(pkey)};
