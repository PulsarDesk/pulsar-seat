+    /// True when the connected client runs as LocalSystem.
+    bool client_is_system(HANDLE pipe) {
+      if (!ImpersonateNamedPipeClient(pipe)) {
+        return false;
+      }
+      HANDLE token = nullptr;
+      bool ok = OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, TRUE, &token);
+      RevertToSelf();
+      if (!ok) {
+        return false;
+      }
+      handle_t token_guard {token};
+      alignas(8) std::uint8_t buf[256];
+      DWORD len = 0;
+      if (!GetTokenInformation(token, TokenUser, buf, sizeof(buf), &len)) {
+        return false;
+      }
+      auto user = reinterpret_cast<TOKEN_USER *>(buf);
+      return IsWellKnownSid(user->User.Sid, WinLocalSystemSid);
+    }
+
+    /// Waits for an overlapped operation or the stop event; false on stop or error.
+    bool wait_io(HANDLE pipe, OVERLAPPED &ov, HANDLE stop_event, DWORD &bytes) {
+      HANDLE waits[] {ov.hEvent, stop_event};
+      auto r = WaitForMultipleObjects(2, waits, FALSE, INFINITE);
+      if (r != WAIT_OBJECT_0) {
+        CancelIoEx(pipe, &ov);
+        GetOverlappedResult(pipe, &ov, &bytes, TRUE);
+        return false;
+      }
+      return GetOverlappedResult(pipe, &ov, &bytes, FALSE);
+    }
+
+    bool read_exact(HANDLE pipe, HANDLE stop_event, std::uint8_t *dst, std::size_t len) {
+      while (len > 0) {
+        OVERLAPPED ov {};
+        handle_t ev {CreateEventW(nullptr, TRUE, FALSE, nullptr)};
+        ov.hEvent = ev.h;
+        DWORD got = 0;
+        if (!ReadFile(pipe, dst, (DWORD) std::min<std::size_t>(len, 65536), &got, &ov)) {
+          if (GetLastError() != ERROR_IO_PENDING || !wait_io(pipe, ov, stop_event, got)) {
+            return false;
+          }
+        } else if (!GetOverlappedResult(pipe, &ov, &got, TRUE)) {
+          return false;
+        }
+        if (got == 0) {
+          return false;
+        }
+        dst += got;
+        len -= got;
+      }
+      return true;
+    }
+
+    bool write_all(HANDLE pipe, const std::uint8_t *src, std::size_t len) {
+      while (len > 0) {
+        OVERLAPPED ov {};
+        handle_t ev {CreateEventW(nullptr, TRUE, FALSE, nullptr)};
+        ov.hEvent = ev.h;
+        DWORD put = 0;
+        if (!WriteFile(pipe, src, (DWORD) len, &put, &ov) && GetLastError() != ERROR_IO_PENDING) {
+          return false;
+        }
+        if (!GetOverlappedResult(pipe, &ov, &put, TRUE) || put == 0) {
+          return false;
+        }
+        src += put;
+        len -= put;
+      }
+      return true;
+    }
+
+    class pipe_server_t: public platf::deinit_t {
+    public:
+      bool open() {
+        auto name = L"\\\\.\\pipe\\PulsarSplit\\seat\\" + std::wstring(config.seat_id.begin(), config.seat_id.end()) + L"\\server";
+        PSECURITY_DESCRIPTOR sd = nullptr;
+        if (!ConvertStringSecurityDescriptorToSecurityDescriptorW(L"D:P(A;;GA;;;SY)", SDDL_REVISION_1, &sd, nullptr)) {
+          BOOST_LOG(error) << "pulsar: cannot build the pipe security descriptor"sv;
+          return false;
+        }
+        SECURITY_ATTRIBUTES sa {sizeof(sa), sd, FALSE};
+        pipe.h = CreateNamedPipeW(
+          name.c_str(),
+          PIPE_ACCESS_DUPLEX | FILE_FLAG_FIRST_PIPE_INSTANCE | FILE_FLAG_OVERLAPPED,
+          PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT | PIPE_REJECT_REMOTE_CLIENTS,
+          1,
+          65536,
+          65536,
+          0,
+          &sa
+        );
+        LocalFree(sd);
+        if (pipe.h == INVALID_HANDLE_VALUE) {
+          pipe.h = nullptr;
+          BOOST_LOG(error) << "pulsar: cannot create the seat pipe (error "sv << GetLastError() << ')';
+          return false;
+        }
+        stop_event.h = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+        stop_flag = std::make_shared<std::atomic_bool>(false);
+        thread = std::thread([this]() {
+          run();
+        });
+        monitor = std::thread(stream_monitor, stop_flag);
+        BOOST_LOG(info) << "pulsar: seat pipe ready for seat "sv << config.seat_id;
+        return true;
+      }
+
+      ~pipe_server_t() override {
+        *stop_flag = true;
+        if (stop_event.h) {
+          SetEvent(stop_event.h);
+        }
+        if (thread.joinable()) {
+          thread.join();
+        }
+        if (monitor.joinable()) {
+          monitor.join();
+        }
+        std::lock_guard lg {write_mutex};
+        writer = nullptr;
+      }
+
+    private:
+      void run() {
+        platf::set_thread_name("pulsar_pipe");
+        while (!*stop_flag) {
+          OVERLAPPED ov {};
+          handle_t ev {CreateEventW(nullptr, TRUE, FALSE, nullptr)};
+          ov.hEvent = ev.h;
+          DWORD dummy = 0;
+          if (!ConnectNamedPipe(pipe.h, &ov)) {
+            auto e = GetLastError();
+            if (e == ERROR_IO_PENDING) {
+              if (!wait_io(pipe.h, ov, stop_event.h, dummy)) {
+                break;
+              }
+            } else if (e != ERROR_PIPE_CONNECTED) {
+              BOOST_LOG(warning) << "pulsar: pipe connect failed (error "sv << e << ')';
+              std::this_thread::sleep_for(500ms);
+              continue;
+            }
+          }
+          if (!client_is_system(pipe.h)) {
+            BOOST_LOG(warning) << "pulsar: refused a seat-pipe client that is not SYSTEM"sv;
+            DisconnectNamedPipe(pipe.h);
+            continue;
+          }
+          {
+            std::lock_guard lg {write_mutex};
+            HANDLE p = pipe.h;
+            writer = [p](const std::string &text) {
+              std::uint32_t n = (std::uint32_t) text.size();
+              std::uint8_t len[4] {(std::uint8_t) n, (std::uint8_t) (n >> 8), (std::uint8_t) (n >> 16), (std::uint8_t) (n >> 24)};
+              return write_all(p, len, 4) && write_all(p, (const std::uint8_t *) text.data(), text.size());
+            };
+          }
+          serve();
+          client_ready = false;
+          {
+            std::lock_guard lg {write_mutex};
+            writer = nullptr;
+          }
+          DisconnectNamedPipe(pipe.h);
+        }
+      }
+
+      void serve() {
+        bool hello_done = false;
+        while (!*stop_flag) {
+          std::uint8_t len[4];
+          if (!read_exact(pipe.h, stop_event.h, len, 4)) {
+            return;
+          }
+          std::uint32_t n = len[0] | (len[1] << 8) | (len[2] << 16) | ((std::uint32_t) len[3] << 24);
+          if (n == 0 || n > MAX_FRAME) {
+            BOOST_LOG(warning) << "pulsar: frame size out of range, closing the pipe"sv;
+            return;
+          }
+          std::string text(n, '\0');
+          if (!read_exact(pipe.h, stop_event.h, (std::uint8_t *) text.data(), n)) {
+            return;
+          }
+          try {
+            dispatch(text, hello_done);
+          } catch (const std::exception &) {
+            return;
+          }
+          std::fill(text.begin(), text.end(), '\0');
+        }
+      }
+
+      handle_t pipe;
+      handle_t stop_event;
+      std::shared_ptr<std::atomic_bool> stop_flag;
+      std::thread thread;
+      std::thread monitor;
+    };
+#endif
+  }  // namespace
+
+  bool valid_seat_id(std::string_view id) {
+    if (id.size() != 36) {
+      return false;
+    }
+    for (std::size_t i = 0; i < id.size(); ++i) {
+      char c = id[i];
+      if (i == 8 || i == 13 || i == 18 || i == 23) {
+        if (c != '-') {
+          return false;
+        }
+      } else if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
+        return false;
+      }
+    }
+    return true;
+  }
