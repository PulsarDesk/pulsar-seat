+  void on_launch(int width, int height, int fps, bool hdr) {
+    std::lock_guard lg {state_mutex};
+    last_video = nlohmann::json {{"width", width}, {"height", height}, {"fps", fps}, {"hdr", hdr}};
+  }
+
+  void audio_state(std::string_view s) {
+    emit("audio.state", {{"state", std::string(s)}});
+  }
+
+  void capture_error(std::string_view code) {
+    {
+      std::lock_guard lg {state_mutex};
+      if (capture_error_code == code) {
+        return;
+      }
+      capture_error_code = std::string(code);
+    }
+    emit("capture.error", {{"code", code.empty() ? nlohmann::json(nullptr) : nlohmann::json(std::string(code))}});
+  }
+
+  std::string last_capture_error() {
+    std::lock_guard lg {state_mutex};
+    return capture_error_code;
+  }
+}  // namespace pulsar
