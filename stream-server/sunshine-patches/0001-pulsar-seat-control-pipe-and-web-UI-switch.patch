+    bool write_message(const nlohmann::json &msg) {
+      std::string text;
+      try {
+        text = msg.dump(-1, ' ', false, nlohmann::json::error_handler_t::replace);
+      } catch (const std::exception &e) {
+        BOOST_LOG(error) << "pulsar: cannot serialise message: "sv << e.what();
+        return false;
+      }
+      if (text.size() > MAX_FRAME) {
+        BOOST_LOG(error) << "pulsar: message too large, dropped"sv;
+        return false;
+      }
+      std::lock_guard lg {write_mutex};
+      if (!writer) {
+        return false;
+      }
+      return writer(text);
+    }
