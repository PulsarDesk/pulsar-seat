+  bool pulsar_pair_pending() {
+    std::unique_lock lg {pulsar_pair_mutex};
+    for (auto &[_, sess] : map_id_sess) {
+      if (pulsar_held(sess)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void pulsar_pair_submit(std::optional<std::uint32_t> request_id, const std::string &pin, const std::string &name, std::function<void(pulsar_pair_result_t)> done) {
+    std::unique_lock lg {pulsar_pair_mutex};
+
+    auto it = std::find_if(map_id_sess.begin(), map_id_sess.end(), [&](auto &entry) {
+      auto &sess = entry.second;
+      return pulsar_held(sess) && (!request_id || sess.pulsar_request_id == *request_id);
+    });
+    if (it == map_id_sess.end()) {
+      done({"no_pending_request", "no pairing request is waiting", ""});
+      return;
+    }
+
+    auto uniq_id = it->first;
+    it->second.pulsar_done = std::move(done);
+    it->second.client.name = name;
+
+    // Take the held client response out first: getservercert() may drop the session.
+    auto held = std::move(it->second.async_insert_pin.response);
+    it->second.async_insert_pin.response = std::decay_t<decltype(held.left())>();
+
+    pt::ptree tree;
+    getservercert(it->second, tree, pin);
+
+    std::ostringstream data;
+    pt::write_xml(data, tree);
+    if (held.has_left() && held.left()) {
+      held.left()->write(data.str());
+    } else if (held.has_right() && held.right()) {
+      held.right()->write(data.str());
+    }
+    // On success the session stays; `pulsar_done` fires when the client's last step
+    // (clientpairingsecret) succeeds or fails, or when the request times out.
+    (void) uniq_id;
+  }
+
+  bool pulsar_pair_cancel(std::optional<std::uint32_t> request_id) {
+    std::unique_lock lg {pulsar_pair_mutex};
+    for (auto it = map_id_sess.begin(); it != map_id_sess.end(); ++it) {
+      auto &sess = it->second;
+      if (sess.pulsar_request_id == 0 || (request_id && sess.pulsar_request_id != *request_id)) {
+        continue;
+      }
+      pt::ptree tree;
+      tree.put("root.paired", 0);
+      tree.put("root.<xmlattr>.status_code", 400);
+      tree.put("root.<xmlattr>.status_message", "Pairing cancelled by the host");
+      pulsar_answer_held(sess, tree);
+      pulsar_finish(sess, "cancelled"sv);
+      map_id_sess.erase(it);
+      return true;
+    }
+    return false;
+  }
 }  // namespace nvhttp
