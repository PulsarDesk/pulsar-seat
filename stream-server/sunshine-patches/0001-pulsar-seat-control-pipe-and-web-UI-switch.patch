+
+      register_handler("pair.submit", [](const nlohmann::json &body, responder_t respond) -> std::optional<nlohmann::json> {
+        if (!body.contains("pin") || !body["pin"].is_string() || !body.contains("name") || !body["name"].is_string()) {
+          throw error_t {"bad_request", "pin and name are required"};
+        }
+        auto pin = body["pin"].get<std::string>();
+        auto name = body["name"].get<std::string>();
+        if (pin.size() != 4 || !std::all_of(pin.begin(), pin.end(), [](char c) {
+              return c >= '0' && c <= '9';
+            })) {
+          throw error_t {"bad_request", "the PIN must be 4 digits"};
+        }
+        if (name.empty() || name.size() > 256) {
+          throw error_t {"bad_request", "name must be 1-64 characters"};
+        }
+        nvhttp::pulsar_pair_submit(opt_request_id(body), pin, name, [respond](nvhttp::pulsar_pair_result_t r) {
+          if (r.code.empty()) {
+            respond(true, nlohmann::json {{"uuid", r.uuid}});
+          } else {
+            respond(false, err(r.code, r.detail));
+          }
+        });
+        // Wipe the local copy of the PIN.
+        std::fill(pin.begin(), pin.end(), '\0');
+        return std::nullopt;
+      });
