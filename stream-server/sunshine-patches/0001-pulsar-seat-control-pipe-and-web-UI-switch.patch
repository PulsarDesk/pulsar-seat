+    struct handle_t {
+      HANDLE h = nullptr;
+
+      handle_t() = default;
+
+      explicit handle_t(HANDLE v):
+          h(v) {
+      }
+
+      handle_t(const handle_t &) = delete;
+      handle_t &operator=(const handle_t &) = delete;
