+    /// Watches the stream sessions for `stream.started` / `stream.ended`.
+    void stream_monitor(std::shared_ptr<std::atomic_bool> stop) {
+      int last = 0;
+      while (!*stop) {
+        std::this_thread::sleep_for(500ms);
+        int now = rtsp_stream::session_count();
+        if (last == 0 && now > 0) {
+          nlohmann::json video;
+          {
+            std::lock_guard lg {state_mutex};
+            video = last_video ? *last_video : nlohmann::json(nullptr);
+          }
+          emit("stream.started", {{"app", app_json()}, {"video", video}});
+          if (!::config::audio.stream) {
+            audio_state("disabled");
+          }
+        } else if (last > 0 && now == 0) {
+          emit("stream.ended", {{"reason", "client_disconnected"}});
+        }
+        last = now;
+      }
+    }
