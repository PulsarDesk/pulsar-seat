+    void dispatch(const std::string &text, bool &hello_done) {
+      nlohmann::json msg;
+      try {
+        msg = nlohmann::json::parse(text);
+      } catch (const std::exception &) {
+        BOOST_LOG(warning) << "pulsar: request is not JSON"sv;
+        return;
+      }
+      if (!msg.is_object() || !msg.contains("id") || !msg["id"].is_number_unsigned() || !msg.contains("type") || !msg["type"].is_string()) {
+        BOOST_LOG(warning) << "pulsar: malformed request"sv;
+        return;
+      }
+      auto id = msg["id"].get<std::uint32_t>();
+      auto type = msg["type"].get<std::string>();
+      nlohmann::json body = msg.contains("body") && msg["body"].is_object() ? msg["body"] : nlohmann::json::object();
+
+      auto answered = std::make_shared<std::atomic_bool>(false);
+      responder_t respond = [id, answered](bool ok, nlohmann::json payload) {
+        if (answered->exchange(true)) {
+          return;
+        }
+        nlohmann::json out {{"id", id}, {"ok", ok}};
+        out[ok ? "body" : "error"] = std::move(payload);
+        write_message(out);
+      };
+
+      if (type == "hello") {
+        auto protocol = body.value("protocol", 0u);
+        if (protocol != PROTOCOL) {
+          respond(false, err("unsupported_protocol", "this server speaks protocol 1"));
+          hello_done = false;
+          throw std::runtime_error("unsupported protocol");
+        }
+        hello_done = true;
+        client_ready = true;
+        respond(true, nlohmann::json {
+                        {"protocol", PROTOCOL},
+                        {"server_version", std::string(PROJECT_VERSION)},
+                        {"seat_id", config.seat_id},
+                        {"capabilities", capabilities()},
+                      });
+        return;
+      }
+      if (!hello_done) {
+        respond(false, err("bad_request", "hello must be the first request"));
+        return;
+      }
+
+      handler_t handler;
+      {
+        std::lock_guard lg {state_mutex};
+        auto it = handlers.find(type);
+        if (it != handlers.end()) {
+          handler = it->second;
+        }
+      }
+      if (!handler) {
+        respond(false, err("bad_request", "unknown request type"));
+        return;
+      }
+      try {
+        auto result = handler(body, respond);
+        if (result) {
+          respond(true, std::move(*result));
+        }
+      } catch (const error_t &e) {
+        respond(false, err(e.code, e.detail));
+      } catch (const std::exception &e) {
+        respond(false, err("internal", e.what()));
+      }
+    }
