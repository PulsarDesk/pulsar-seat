--- /dev/null
+++ b/src/pulsar/control.h
@@ -0,0 +1,106 @@
+/**
+ * @file src/pulsar/control.h
+ * @brief Pulsar Seat: seat control pipe of a per-seat stream server.
+ *
+ * SPDX-License-Identifier: GPL-3.0-only
+ *
+ * Part of the Pulsar Seat patch set for Sunshine (GPL-3.0). When the config file sets
+ * `pulsar_seat_id`, the server creates `\\.\pipe\PulsarSplit\seat\<seat-id>\server`
+ * (SYSTEM only, first instance, no remote clients) before it opens any network listener.
+ * The Pulsar Seat service is its only client. Messages are a 4-byte little-endian length
+ * followed by one UTF-8 JSON object (requests `{id, type, body}`, responses
+ * `{id, ok, body | error}`, events `{event, body}`). The browser web UI can be turned off
+ * with `pulsar_web_ui = disabled`; the Moonlight protocol listeners are unaffected.
+ */
+#pragma once
+
+// standard includes
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// lib includes
+#include <nlohmann/json.hpp>
+
+// local includes
+#include "src/platform/common.h"
+
+namespace pulsar {
+  /// Protocol version of the seat pipe.
+  constexpr std::uint32_t PROTOCOL = 1;
+  /// Largest frame in either direction.
+  constexpr std::size_t MAX_FRAME = 1024 * 1024;
+
+  struct config_t {
+    /// Lowercase GUID without braces; empty = not a Pulsar seat (upstream behaviour).
+    std::string seat_id;
+    /// `pulsar_web_ui`: false = the HTTPS config server on base+1 is never created.
+    bool web_ui = true;
+    /// `pulsar_control_pipe`: defaults to on when a seat id is set.
+    std::optional<bool> control_pipe;
+    /// `pulsar_pair_timeout` in seconds (10-600).
+    int pair_timeout = 120;
+  };
+
+  extern config_t config;
+
+  /// A Pulsar seat id is configured.
+  bool active();
+  /// The browser web UI may start.
+  bool web_ui_enabled();
+  /// The seat pipe is wanted.
+  bool pipe_enabled();
+  /// True when `id` is a lowercase GUID without braces.
+  bool valid_seat_id(std::string_view id);
+
+  /// Error answer of a request handler (spec codes: bad_request, not_found, busy, ...).
+  struct error_t {
+    std::string code;
+    std::string detail;
+  };
+
+  /// Sends the response of one request; may be called from any thread, once.
+  using responder_t = std::function<void(bool ok, nlohmann::json body_or_error)>;
+  /// A request handler. Synchronous handlers return the body (or throw `error_t`);
+  /// asynchronous ones call `respond` later and return `std::nullopt`.
+  using handler_t = std::function<std::optional<nlohmann::json>(const nlohmann::json &body, responder_t respond)>;
+
+  /// Registers (or replaces) the handler of a request type.
+  void register_handler(const std::string &type, handler_t handler);
+  /// Adds a capability string reported in the `hello` answer.
+  void add_capability(const std::string &capability);
+  /// Capabilities reported in the `hello` answer.
+  std::vector<std::string> capabilities();
+
+  /// Sends an event to the connected service (dropped while no client is connected).
+  void emit(const std::string &event, nlohmann::json body);
+  /// A client is connected and has completed `hello`.
+  bool connected();
+
+  /// Creates the pipe and its thread. Returns nullptr when the pipe is wanted but cannot be
+  /// created (the caller exits); returns an empty guard when the pipe is not wanted.
+  std::unique_ptr<platf::deinit_t> start();
+  /// The server finished starting (status `ready`).
+  void set_ready();
+  /// The server is shutting down (status `stopping`).
+  void set_stopping();
+
+  // ---- hooks called by the upstream code ----
+
+  /// A `/pair` request waits for a PIN.
+  void on_pair_pending(std::uint32_t request_id, const std::string &client_uniqueid, const std::string &device_name);
+  /// A pending pair request finished (`paired`, `wrong_pin`, `timeout`, `cancelled`, `client_gone`).
+  void on_pair_ended(std::uint32_t request_id, std::string_view result);
+  /// A client launched or resumed a stream with this mode.
+  void on_launch(int width, int height, int fps, bool hdr);
+  /// Audio capture state (`capturing`, `no_device`, `blocked_by_policy`, `disabled`).
+  void audio_state(std::string_view state);
+  /// Capture failed (`no_display`, `adapter_mismatch`, `producer_lost`) or recovered (empty).
+  void capture_error(std::string_view code);
+  /// Last capture error, empty when none.
+  std::string last_capture_error();
+}  // namespace pulsar
