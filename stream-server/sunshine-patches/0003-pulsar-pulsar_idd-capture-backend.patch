diff --git a/src/platform/windows/display.h b/src/platform/windows/display.h
index 2fcb7dc..6fbd26e 100644
--- a/src/platform/windows/display.h
+++ b/src/platform/windows/display.h
@@ -387,4 +387,119 @@ namespace platf::dxgi {
     capture_e snapshot(const pull_free_image_cb_t &pull_free_image_cb, std::shared_ptr<platf::img_t> &img_out, std::chrono::milliseconds timeout, bool cursor_visible) override;
     capture_e release_snapshot() override;
   };
+
+  // ---- Pulsar Seat: `capture = pulsar_idd` (frame channel of the Pulsar Seat IddCx driver) ----
+  // SPDX-License-Identifier: GPL-3.0-only
+
+#pragma pack(push, 1)
+
+  /**
+   * Frame channel header v1 at offset 0 of `Global\PulsarSplit.Display.<seat>.Header`
+   * (little-endian, packed; same layout as the driver's PULSAR_FRAME_HEADER_V1).
+   */
+  struct pulsar_frame_header_t {
+    char magic[4];  // "PSDH"
+    std::uint16_t version;  // 1
+    std::uint16_t header_size;
+    std::uint8_t seat_guid[16];
+    std::uint32_t generation;
+    std::uint32_t ring_size;  // 3
+    std::uint64_t frame_number;
+    std::uint32_t latest_index;
+    std::uint32_t flags;  // bit 0 path active, bit 1 HDR, bit 2 driver stopping
+    std::uint64_t fence_value;
+    std::uint64_t present_qpc;
+    std::uint32_t width;
+    std::uint32_t height;
+    std::uint32_t refresh_milli_hz;
+    std::uint32_t dxgi_format;  // 87 B8G8R8A8_UNORM or 10 R16G16B16A16_FLOAT
+    std::uint32_t color_space;
+    std::uint64_t adapter_luid;
+    std::uint32_t hdr_meta_generation;
+    std::uint16_t chromaticity[8];  // R x,y G x,y B x,y W x,y; CIE * 1024
+    std::uint32_t min_luminance_x10000;
+    std::uint32_t max_luminance_x10000;
+    std::uint32_t max_full_frame_luminance_x10000;
+    std::uint32_t sdr_white_nits;
+    std::uint8_t reserved[8];
+    std::uint64_t producer_heartbeat;  // QPC
+    std::uint64_t consumer_heartbeat;  // QPC, written by us
+    std::uint64_t consumer_frame;  // written by us
+  };
+
+#pragma pack(pop)
+
+  static_assert(sizeof(pulsar_frame_header_t) == 0xA0, "frame header v1 is 160 bytes");
+
+  /**
+   * Consumer side of the frame channel: header section, FrameReady event, named shared
+   * ring textures and fence of the current generation.
+   */
+  class pulsar_idd_channel_t {
+  public:
+    ~pulsar_idd_channel_t();
+
+    /// Opens the header section and the FrameReady event of the seat (`no_display` when missing).
+    int open(const std::string &seat_id);
+    /// Consistent copy of the header; false when it is not valid.
+    bool read_header(pulsar_frame_header_t &out) const;
+    /// Opens the ring textures and the fence of `header.generation` on `device`.
+    int open_ring(ID3D11Device *device, IDXGIAdapter1 *adapter, const pulsar_frame_header_t &header);
+    /**
+     * Waits for the next published frame. On `ok`, `out` is the ring texture (already
+     * ordered after the producer's copy on `ctx`) and `qpc` its present time.
+     */
+    capture_e next_frame(ID3D11DeviceContext *ctx, std::chrono::milliseconds timeout, texture2d_t &out, std::uint64_t &qpc);
+    /// Writes the consumer heartbeat.
+    void heartbeat();
+
+    pulsar_frame_header_t opened {};
+
+  private:
+    HANDLE section = nullptr;
+    pulsar_frame_header_t *view = nullptr;
+    HANDLE frame_ready = nullptr;
+    std::string seat;
+    texture2d_t ring[4];
+    util::safe_ptr<ID3D11Fence, Release<ID3D11Fence>> fence;
+    std::uint64_t last_frame = 0;
+    std::chrono::steady_clock::time_point producer_lost_since {};
+    bool producer_lost = false;
+  };
+
+  /**
+   * Shared init of both `pulsar_idd` displays: adapter by the header's LUID, D3D11 device,
+   * size / format / refresh from the header, mode request to the service.
+   */
+  int pulsar_idd_init(display_base_t *display, pulsar_idd_channel_t &channel, const ::video::config_t &config);
+  /// HDR metadata from the frame header.
+  bool pulsar_idd_hdr_metadata(const pulsar_frame_header_t &header, SS_HDR_METADATA &metadata);
+
+  /**
+   * Pulsar frame channel with a hardware encoder.
+   */
+  class display_pulsar_idd_vram_t: public display_vram_t {
+    pulsar_idd_channel_t channel;
+
+  public:
+    int init(const ::video::config_t &config, const std::string &display_name);
+    capture_e snapshot(const pull_free_image_cb_t &pull_free_image_cb, std::shared_ptr<platf::img_t> &img_out, std::chrono::milliseconds timeout, bool cursor_visible) override;
+    capture_e release_snapshot() override;
+    bool is_hdr() override;
+    bool get_hdr_metadata(SS_HDR_METADATA &metadata) override;
+  };
+
+  /**
+   * Pulsar frame channel with a software encoder.
+   */
+  class display_pulsar_idd_ram_t: public display_ram_t {
+    pulsar_idd_channel_t channel;
+
+  public:
+    int init(const ::video::config_t &config, const std::string &display_name);
+    capture_e snapshot(const pull_free_image_cb_t &pull_free_image_cb, std::shared_ptr<platf::img_t> &img_out, std::chrono::milliseconds timeout, bool cursor_visible) override;
+    capture_e release_snapshot() override;
+    bool is_hdr() override;
+    bool get_hdr_metadata(SS_HDR_METADATA &metadata) override;
+  };
 }  // namespace platf::dxgi
