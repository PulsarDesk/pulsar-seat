diff --git a/src/platform/windows/display_pulsar_idd.cpp b/src/platform/windows/display_pulsar_idd.cpp
new file mode 100644
index 0000000..33f564f
--- /dev/null
+++ b/src/platform/windows/display_pulsar_idd.cpp
@@ -0,0 +1,533 @@
+/**
+ * @file src/platform/windows/display_pulsar_idd.cpp
+ * @brief Pulsar Seat: `capture = pulsar_idd`, the frame channel of the Pulsar Seat IddCx driver.
+ *
+ * SPDX-License-Identifier: GPL-3.0-only
+ *
+ * The driver (producer, a WUDF host) publishes each frame of the seat's virtual monitor
+ * into a ring of three named NT-shared D3D11 textures on the render adapter, signals a
+ * named shared fence, updates a 4 KiB header section and sets an auto-reset event:
+ *
+ *   Global\PulsarSplit.Display.<seat>.Header       section (header v1, "PSDH")
+ *   Global\PulsarSplit.Display.<seat>.FrameReady   auto-reset event
+ *   Global\PulsarSplit.Display.<seat>.Tex<gen>.<i> textures, i = 0..2
+ *   Global\PulsarSplit.Display.<seat>.Fence<gen>   fence
+ *
+ * This file is the consumer. It opens everything by name (the server runs as SYSTEM in
+ * the seat session; the objects grant SYSTEM), waits on the fence before it copies a
+ * slot, writes its heartbeat and the frame it holds, and asks the Pulsar Seat service for
+ * the client's mode over the seat pipe (`display.mode.request` / `display.mode.result`).
+ */
+// standard includes
+#include <atomic>
+#include <condition_variable>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <thread>
+
+// platform includes
+#include <d3d12.h>
+
+// local includes
+#include "display.h"
+#include "misc.h"
+#include "src/config.h"
+#include "src/logging.h"
+#include "src/pulsar/control.h"
+#include "utf_utils.h"
+
+using namespace std::literals;
+
+namespace platf::dxgi {
+  namespace {
+    constexpr std::uint32_t FLAG_PATH_ACTIVE = 0x1;
+    constexpr std::uint32_t FLAG_HDR = 0x2;
+    constexpr std::uint32_t FLAG_DRIVER_STOPPING = 0x4;
+    constexpr auto PRODUCER_GRACE = 10s;
+    constexpr auto MODE_TIMEOUT = 5s;
+
+    std::wstring object_name(const std::string &seat, const std::string &suffix) {
+      auto s = "Global\\PulsarSplit.Display." + seat + "." + suffix;
+      return std::wstring(s.begin(), s.end());
+    }
+
+    std::uint64_t qpc_now() {
+      LARGE_INTEGER v;
+      QueryPerformanceCounter(&v);
+      return (std::uint64_t) v.QuadPart;
+    }
+
+    std::uint64_t qpc_freq() {
+      LARGE_INTEGER v;
+      QueryPerformanceFrequency(&v);
+      return (std::uint64_t) v.QuadPart;
+    }
+
+    // ---- display.mode.request / display.mode.result over the seat pipe ----
+
+    std::mutex mode_mutex;
+    std::condition_variable mode_cv;
+    std::map<std::uint32_t, std::string> mode_results;
+    std::uint32_t mode_counter = 0;
+    std::once_flag mode_handler_once;
+
+    void install_mode_handler() {
+      std::call_once(mode_handler_once, []() {
+        pulsar::register_handler("display.mode.result", [](const nlohmann::json &body, pulsar::responder_t) -> std::optional<nlohmann::json> {
+          auto id = body.value("request_id", 0u);
+          auto status = body.value("status", "unsupported"s);
+          {
+            std::lock_guard lg {mode_mutex};
+            mode_results[id] = status;
+          }
+          mode_cv.notify_all();
+          return nlohmann::json::object();
+        });
+        pulsar::add_capability("pulsar_idd");
+      });
+    }
+
+    /// Asks the service for the client's mode; returns the status word or "timeout".
+    std::string request_mode(int width, int height, int fps, bool hdr) {
+      if (!pulsar::connected()) {
+        return "no_pipe";
+      }
+      std::uint32_t id;
+      {
+        std::lock_guard lg {mode_mutex};
+        id = ++mode_counter;
+        if (id == 0) {
+          id = ++mode_counter;
+        }
+      }
+      pulsar::emit("display.mode.request", {{"request_id", id}, {"w", width}, {"h", height}, {"hz", fps}, {"hdr", hdr}});
+      std::unique_lock lg {mode_mutex};
+      if (!mode_cv.wait_for(lg, MODE_TIMEOUT, [&]() {
+            return mode_results.contains(id);
+          })) {
+        return "timeout";
+      }
+      auto status = mode_results[id];
+      mode_results.erase(id);
+      return status;
+    }
+
+    /// Launch generation whose mode was already asked for (encoder probes never ask).
+    std::uint32_t last_requested_launch = 0;
+  }  // namespace
+
+  pulsar_idd_channel_t::~pulsar_idd_channel_t() {
+    if (view) {
+      UnmapViewOfFile(view);
+    }
+    if (section) {
+      CloseHandle(section);
+    }
+    if (frame_ready) {
+      CloseHandle(frame_ready);
+    }
+  }
+
+  int pulsar_idd_channel_t::open(const std::string &seat_id) {
+    seat = seat_id;
+    section = OpenFileMappingW(FILE_MAP_READ | FILE_MAP_WRITE, FALSE, object_name(seat, "Header").c_str());
+    if (!section) {
+      BOOST_LOG(error) << "pulsar_idd: no frame channel for seat "sv << seat << " (error "sv << GetLastError() << ')';
+      return -1;
+    }
+    view = (pulsar_frame_header_t *) MapViewOfFile(section, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, 4096);
+    if (!view) {
+      BOOST_LOG(error) << "pulsar_idd: cannot map the frame header (error "sv << GetLastError() << ')';
+      return -1;
+    }
+    frame_ready = OpenEventW(SYNCHRONIZE, FALSE, object_name(seat, "FrameReady").c_str());
+    if (!frame_ready) {
+      BOOST_LOG(error) << "pulsar_idd: cannot open FrameReady (error "sv << GetLastError() << ')';
+      return -1;
+    }
+    return 0;
+  }
+
+  bool pulsar_idd_channel_t::read_header(pulsar_frame_header_t &out) const {
+    if (!view) {
+      return false;
+    }
+    for (int tries = 0; tries < 8; ++tries) {
+      auto before = ((volatile pulsar_frame_header_t *) view)->frame_number;
+      std::atomic_thread_fence(std::memory_order_acquire);
+      std::memcpy(&out, (const void *) view, sizeof(out));
+      std::atomic_thread_fence(std::memory_order_acquire);
+      auto after = ((volatile pulsar_frame_header_t *) view)->frame_number;
+      if (before == after) {
+        return std::memcmp(out.magic, "PSDH", 4) == 0 && out.version == 1 && out.header_size >= sizeof(out) &&
+               out.ring_size > 0 && out.ring_size <= 4 && out.latest_index < out.ring_size;
+      }
+    }
+    return false;
+  }
+
+  int pulsar_idd_channel_t::open_ring(ID3D11Device *device, IDXGIAdapter1 *adapter, const pulsar_frame_header_t &header) {
+    for (auto &t : ring) {
+      t.reset();
+    }
+    fence.reset();
+
+    device1_t device1;
+    if (FAILED(device->QueryInterface(__uuidof(ID3D11Device1), (void **) &device1))) {
+      BOOST_LOG(error) << "pulsar_idd: ID3D11Device1 not available"sv;
+      return -1;
+    }
+    for (std::uint32_t i = 0; i < header.ring_size; ++i) {
+      auto name = object_name(seat, "Tex" + std::to_string(header.generation) + "." + std::to_string(i));
+      ID3D11Texture2D *tex = nullptr;
+      auto hr = device1->OpenSharedResourceByName(name.c_str(), DXGI_SHARED_RESOURCE_READ, __uuidof(ID3D11Texture2D), (void **) &tex);
+      if (FAILED(hr)) {
+        BOOST_LOG(error) << "pulsar_idd: cannot open ring texture "sv << i << " [0x"sv << util::hex(hr).to_string_view() << ']';
+        return -1;
+      }
+      ring[i].reset(tex);
+    }
+
+    // A named fence opens only through D3D12; the handle then goes to D3D11.
+    auto d3d12 = LoadLibraryExW(L"d3d12.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    auto create12 = d3d12 ? (PFN_D3D12_CREATE_DEVICE) GetProcAddress(d3d12, "D3D12CreateDevice") : nullptr;
+    if (!create12) {
+      BOOST_LOG(error) << "pulsar_idd: d3d12.dll is not available for the shared fence"sv;
+      return -1;
+    }
+    ID3D12Device *dev12 = nullptr;
+    auto hr = create12(adapter, D3D_FEATURE_LEVEL_11_0, __uuidof(ID3D12Device), (void **) &dev12);
+    if (FAILED(hr)) {
+      BOOST_LOG(error) << "pulsar_idd: D3D12 device for the fence failed [0x"sv << util::hex(hr).to_string_view() << ']';
+      return -1;
+    }
+    HANDLE fence_handle = nullptr;
+    auto fence_name = object_name(seat, "Fence" + std::to_string(header.generation));
+    hr = dev12->OpenSharedHandleByName(fence_name.c_str(), GENERIC_ALL, &fence_handle);
+    dev12->Release();
+    if (FAILED(hr)) {
+      BOOST_LOG(error) << "pulsar_idd: cannot open the shared fence [0x"sv << util::hex(hr).to_string_view() << ']';
+      return -1;
+    }
+    ID3D11Device5 *device5 = nullptr;
+    hr = device->QueryInterface(__uuidof(ID3D11Device5), (void **) &device5);
+    if (SUCCEEDED(hr)) {
+      ID3D11Fence *f = nullptr;
+      hr = device5->OpenSharedFence(fence_handle, __uuidof(ID3D11Fence), (void **) &f);
+      device5->Release();
+      if (SUCCEEDED(hr)) {
+        fence.reset(f);
+      }
+    }
+    CloseHandle(fence_handle);
+    if (!fence) {
+      BOOST_LOG(error) << "pulsar_idd: ID3D11Fence open failed [0x"sv << util::hex(hr).to_string_view() << ']';
+      return -1;
+    }
+
+    opened = header;
+    last_frame = header.frame_number;
+    return 0;
+  }
+
+  void pulsar_idd_channel_t::heartbeat() {
+    if (view) {
+      ((volatile pulsar_frame_header_t *) view)->consumer_heartbeat = qpc_now();
+    }
+  }
+
+  capture_e pulsar_idd_channel_t::next_frame(ID3D11DeviceContext *ctx, std::chrono::milliseconds timeout, texture2d_t &out, std::uint64_t &qpc) {
+    heartbeat();
+
+    pulsar_frame_header_t h;
+    if (!read_header(h)) {
+      return capture_e::timeout;
+    }
+
+    // Producer liveness: heartbeat older than 3 s means gone; keep the client for 10 s.
+    auto freq = qpc_freq();
+    auto now = qpc_now();
+    bool alive = freq != 0 && now >= h.producer_heartbeat && (now - h.producer_heartbeat) <= freq * 3;
+    if (!alive || (h.flags & FLAG_DRIVER_STOPPING)) {
+      auto t = std::chrono::steady_clock::now();
+      if (!producer_lost) {
+        producer_lost = true;
+        producer_lost_since = t;
+        BOOST_LOG(warning) << "pulsar_idd: frame producer stopped answering"sv;
+      }
+      if (t - producer_lost_since > PRODUCER_GRACE) {
+        pulsar::capture_error("producer_lost");
+        return capture_e::error;
+      }
+      std::this_thread::sleep_for(std::min<std::chrono::milliseconds>(timeout, 500ms));
+      return capture_e::timeout;
+    }
+    if (producer_lost) {
+      producer_lost = false;
+      pulsar::capture_error("");
+    }
+
+    if (h.generation != opened.generation || h.width != opened.width || h.height != opened.height || h.dxgi_format != opened.dxgi_format) {
+      BOOST_LOG(info) << "pulsar_idd: frame channel changed (generation "sv << h.generation << ", "sv << h.width << 'x' << h.height << ')';
+      return capture_e::reinit;
+    }
+
+    if (h.frame_number == last_frame) {
+      auto r = WaitForSingleObject(frame_ready, (DWORD) timeout.count());
+      if (r == WAIT_TIMEOUT) {
+        return capture_e::timeout;
+      }
+      if (r != WAIT_OBJECT_0) {
+        return capture_e::error;
+      }
+      if (!read_header(h)) {
+        return capture_e::timeout;
+      }
+      if (h.generation != opened.generation) {
+        return capture_e::reinit;
+      }
+      if (h.frame_number == last_frame) {
+        return capture_e::timeout;
+      }
+    }
+
+    // Hold the slot: the producer never writes the slot of `consumer_frame`.
+    ((volatile pulsar_frame_header_t *) view)->consumer_frame = h.frame_number;
+    last_frame = h.frame_number;
+
+    ID3D11DeviceContext4 *ctx4 = nullptr;
+    if (SUCCEEDED(ctx->QueryInterface(__uuidof(ID3D11DeviceContext4), (void **) &ctx4))) {
+      ctx4->Wait(fence.get(), h.fence_value);
+      ctx4->Release();
+    }
+
+    auto &slot = ring[h.latest_index];
+    if (!slot) {
+      return capture_e::reinit;
+    }
+    slot->AddRef();
+    out.reset(slot.get());
+    qpc = h.present_qpc;
+    return capture_e::ok;
+  }
+
+  int pulsar_idd_init(display_base_t *d, pulsar_idd_channel_t &channel, const ::video::config_t &config) {
+    if (!pulsar::active()) {
+      BOOST_LOG(error) << "capture = pulsar_idd needs pulsar_seat_id"sv;
+      return -1;
+    }
+    install_mode_handler();
+
+    if (channel.open(pulsar::config.seat_id)) {
+      pulsar::capture_error("no_display");
+      return -1;
+    }
+
+    // Ask for the client's mode once per client launch / resume (not for encoder probes);
+    // the service applies it through the driver (spec 40 §4.4).
+    bool hdr_wanted = config.dynamicRange > 0;
+    auto launch = pulsar::launch_generation();
+    if (launch != 0 && launch != last_requested_launch && config.width > 0 && config.height > 0) {
+      last_requested_launch = launch;
+      auto status = request_mode(config.width, config.height, config.framerate, hdr_wanted);
+      BOOST_LOG(info) << "pulsar_idd: mode "sv << config.width << 'x' << config.height << '@' << config.framerate << (hdr_wanted ? " HDR"sv : ""sv) << ": "sv << status;
+      if (status == "ok"sv || status == "ok_sdr_fallback"sv || status == "clamped"sv) {
+        // Give the driver a moment to publish the new generation.
+        std::this_thread::sleep_for(100ms);
+      }
+    }
+
+    pulsar_frame_header_t h;
+    auto deadline = std::chrono::steady_clock::now() + 2s;
+    while (!channel.read_header(h) || !(h.flags & FLAG_PATH_ACTIVE) || h.width == 0 || h.height == 0) {
+      if (std::chrono::steady_clock::now() > deadline) {
+        BOOST_LOG(error) << "pulsar_idd: the seat display has no active path"sv;
+        pulsar::capture_error("no_display");
+        return -1;
+      }
+      std::this_thread::sleep_for(50ms);
+    }
+
+    // Adapter: the render GPU named in the header (no cross-adapter or CPU copy path).
+    if (FAILED(CreateDXGIFactory1(IID_IDXGIFactory1, (void **) &d->factory))) {
+      BOOST_LOG(error) << "pulsar_idd: CreateDXGIFactory1 failed"sv;
+      return -1;
+    }
+    adapter_t::pointer adapter_p;
+    for (int x = 0; d->factory->EnumAdapters1(x, &adapter_p) != DXGI_ERROR_NOT_FOUND; ++x) {
+      adapter_t a {adapter_p};
+      DXGI_ADAPTER_DESC1 desc;
+      a->GetDesc1(&desc);
+      auto luid = ((std::uint64_t) (std::uint32_t) desc.AdapterLuid.HighPart << 32) | desc.AdapterLuid.LowPart;
+      if (luid == h.adapter_luid) {
+        if (!config::video.adapter_name.empty() && utf_utils::from_utf8(config::video.adapter_name) != desc.Description) {
+          BOOST_LOG(warning) << "pulsar_idd: adapter_name is ignored; the seat renders on "sv << utf_utils::to_utf8(desc.Description);
+        }
+        d->adapter = std::move(a);
+        break;
+      }
+    }
+    if (!d->adapter) {
+      BOOST_LOG(error) << "pulsar_idd: no adapter with the seat's render LUID"sv;
+      pulsar::capture_error("adapter_mismatch");
+      return -1;
+    }
+
+    D3D_FEATURE_LEVEL levels[] {D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0};
+    auto hr = D3D11CreateDevice(d->adapter.get(), D3D_DRIVER_TYPE_UNKNOWN, nullptr, D3D11_CREATE_DEVICE_FLAGS, levels, 2, D3D11_SDK_VERSION, &d->device, &d->feature_level, &d->device_ctx);
+    if (FAILED(hr)) {
+      BOOST_LOG(error) << "pulsar_idd: D3D11 device failed [0x"sv << util::hex(hr).to_string_view() << ']';
+      pulsar::capture_error("adapter_mismatch");
+      return -1;
+    }
+
+    if (channel.open_ring(d->device.get(), d->adapter.get(), h)) {
+      pulsar::capture_error("no_display");
+      return -1;
+    }
+
+    d->width = (int) h.width;
+    d->height = (int) h.height;
+    d->width_before_rotation = d->width;
+    d->height_before_rotation = d->height;
+    d->display_rotation = DXGI_MODE_ROTATION_IDENTITY;
+    d->offset_x = 0;
+    d->offset_y = 0;
+    d->env_width = GetSystemMetrics(SM_CXVIRTUALSCREEN);
+    d->env_height = GetSystemMetrics(SM_CYVIRTUALSCREEN);
+    d->capture_format = (DXGI_FORMAT) h.dxgi_format;
+    auto refresh = h.refresh_milli_hz ? h.refresh_milli_hz : 60000;
+    d->display_refresh_rate = DXGI_RATIONAL {refresh, 1000};
+    d->display_refresh_rate_rounded = (int) ((refresh + 500) / 1000);
+    d->client_frame_rate = config.framerate;
+    d->client_frame_rate_strict = {0, 0};
+    if (config.framerateX100 > 0) {
+      AVRational fps = ::video::framerateX100_to_rational(config.framerateX100);
+      d->client_frame_rate_strict = DXGI_RATIONAL {static_cast<UINT>(fps.num), static_cast<UINT>(fps.den)};
+    }
+
+    dxgi_t dxgi_device;
+    if (SUCCEEDED(d->device->QueryInterface(IID_IDXGIDevice, (void **) &dxgi_device))) {
+      dxgi_device->SetGPUThreadPriority(7);
+    }
+    dxgi1_t dxgi_device1;
+    if (SUCCEEDED(d->device->QueryInterface(IID_IDXGIDevice1, (void **) &dxgi_device1))) {
+      dxgi_device1->SetMaximumFrameLatency(1);
+    }
+
+    if (!d->timer || !*d->timer) {
+      BOOST_LOG(error) << "Uninitialized high precision timer";
+      return -1;
+    }
+
+    pulsar::capture_error("");
+    BOOST_LOG(info) << "pulsar_idd: capturing "sv << d->width << 'x' << d->height << " "sv << d->dxgi_format_to_string(d->capture_format) << " at "sv << refresh / 1000.0 << " Hz, generation "sv << h.generation;
+    return 0;
+  }
+
+  bool pulsar_idd_hdr_metadata(const pulsar_frame_header_t &h, SS_HDR_METADATA &metadata) {
+    std::memset(&metadata, 0, sizeof(metadata));
+    if (!(h.flags & FLAG_HDR)) {
+      return false;
+    }
+    // CIE * 1024 -> units of 0.00002
+    auto cie = [](std::uint16_t v) -> std::uint16_t {
+      return (std::uint16_t) ((std::uint32_t) v * 50000 / 1024);
+    };
+    for (int i = 0; i < 3; ++i) {
+      metadata.displayPrimaries[i].x = cie(h.chromaticity[2 * i]);
+      metadata.displayPrimaries[i].y = cie(h.chromaticity[2 * i + 1]);
+    }
+    metadata.whitePoint.x = cie(h.chromaticity[6]);
+    metadata.whitePoint.y = cie(h.chromaticity[7]);
+    metadata.maxDisplayLuminance = (std::uint16_t) (h.max_luminance_x10000 / 10000);
+    metadata.minDisplayLuminance = (std::uint16_t) std::min<std::uint32_t>(h.min_luminance_x10000, 0xFFFF);
+    metadata.maxContentLightLevel = 0;
+    metadata.maxFrameAverageLightLevel = 0;
+    metadata.maxFullFrameLuminance = (std::uint16_t) (h.max_full_frame_luminance_x10000 / 10000);
+    return true;
+  }
+
+  // ---- software encoder variant ----
+
+  int display_pulsar_idd_ram_t::init(const ::video::config_t &config, const std::string &) {
+    return pulsar_idd_init(this, channel, config);
+  }
+
+  capture_e display_pulsar_idd_ram_t::snapshot(const pull_free_image_cb_t &pull_free_image_cb, std::shared_ptr<platf::img_t> &img_out, std::chrono::milliseconds timeout, bool) {
+    texture2d_t src;
+    std::uint64_t frame_qpc = 0;
+    auto status = channel.next_frame(device_ctx.get(), timeout, src, frame_qpc);
+    if (status != capture_e::ok) {
+      return status;
+    }
+    auto frame_timestamp = std::chrono::steady_clock::now() - qpc_time_difference(qpc_counter(), (int64_t) frame_qpc);
+
+    if (!texture) {
+      D3D11_TEXTURE2D_DESC t {};
+      t.Width = width;
+      t.Height = height;
+      t.MipLevels = 1;
+      t.ArraySize = 1;
+      t.SampleDesc.Count = 1;
+      t.Usage = D3D11_USAGE_STAGING;
+      t.Format = capture_format;
+      t.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+      if (FAILED(device->CreateTexture2D(&t, nullptr, &texture))) {
+        BOOST_LOG(error) << "pulsar_idd: staging texture failed"sv;
+        return capture_e::error;
+      }
+    }
+
+    device_ctx->CopyResource(texture.get(), src.get());
+
+    if (!pull_free_image_cb(img_out)) {
+      return capture_e::interrupted;
+    }
+    auto img = (img_t *) img_out.get();
+    if (FAILED(device_ctx->Map(texture.get(), 0, D3D11_MAP_READ, 0, &img_info))) {
+      return capture_e::error;
+    }
+    if (complete_img(img, false)) {
+      device_ctx->Unmap(texture.get(), 0);
+      img_info.pData = nullptr;
+      return capture_e::error;
+    }
+    std::copy_n((std::uint8_t *) img_info.pData, height * img_info.RowPitch, (std::uint8_t *) img->data);
+    device_ctx->Unmap(texture.get(), 0);
+    img_info.pData = nullptr;
+    img->frame_timestamp = frame_timestamp;
+    return capture_e::ok;
+  }
+
+  capture_e display_pulsar_idd_ram_t::release_snapshot() {
+    return capture_e::ok;
+  }
+
+  bool display_pulsar_idd_ram_t::is_hdr() {
+    return (channel.opened.flags & FLAG_HDR) && channel.opened.dxgi_format == DXGI_FORMAT_R16G16B16A16_FLOAT;
+  }
+
+  bool display_pulsar_idd_ram_t::get_hdr_metadata(SS_HDR_METADATA &metadata) {
+    return pulsar_idd_hdr_metadata(channel.opened, metadata);
+  }
+
+  // ---- hardware encoder variant (snapshot lives in display_vram.cpp) ----
+
+  int display_pulsar_idd_vram_t::init(const ::video::config_t &config, const std::string &) {
+    return pulsar_idd_init(this, channel, config);
+  }
+
+  capture_e display_pulsar_idd_vram_t::release_snapshot() {
+    return capture_e::ok;
+  }
+
+  bool display_pulsar_idd_vram_t::is_hdr() {
+    return (channel.opened.flags & FLAG_HDR) && channel.opened.dxgi_format == DXGI_FORMAT_R16G16B16A16_FLOAT;
+  }
+
+  bool display_pulsar_idd_vram_t::get_hdr_metadata(SS_HDR_METADATA &metadata) {
+    return pulsar_idd_hdr_metadata(channel.opened, metadata);
+  }
