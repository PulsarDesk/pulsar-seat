{
  "name": "pulsar-seat",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "workspaces": ["apps/*"],
  "scripts": {
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "check": "bun run --filter '*' check",
    "coverage": "bun run coverage:rust && bun run coverage:split-manager",
    "coverage:rust": "bun scripts/coverage-rust.ts",
    "coverage:split-manager": "bun run --filter '@pulsar-split/manager' coverage"
  }
}
