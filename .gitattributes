# Line endings: LF in the repository and in the working tree for every text file.
# PowerShell, msbuild, WiX and NSIS read LF files fine, so no file needs CRLF.
# UTF-16 files (the kernel driver INFs) are detected as binary by text=auto and kept as is.
* text=auto eol=lf

*.png binary
*.ico binary
*.cat binary
*.sys binary
*.dll binary
*.exe binary

# Vendored third-party sources are pinned by SHA-256 (shim/module/build.rs): keep them byte-exact
# (upstream disasm.cpp has two CRLF lines).
shim/third_party/** -text

# Patches against the pinned stream-server source: byte-exact (git apply --check in CI).
stream-server/sunshine-patches/*.patch -text
