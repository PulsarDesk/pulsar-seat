<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<!-- Pulsar Seat IddCx driver, one binary with the local and the remote role (UMDF 2; built
     against IddCx 1.10, minimum 1.4, 1.10 calls of the remote role guarded at run time). Needs Visual Studio / Build Tools with
     the matching WDK. Built with WDK 10.0.28000 (unsigned). See README.md. -->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{8E4C2D1A-5B7F-4C3E-9A61-2F0D7B5C9E14}</ProjectGuid>
    <RootNamespace>seat_idd</RootNamespace>
    <!-- WDK 10.0.28000: the first WDK whose MSBuild tasks load in VS 2026 (18). -->
    <WindowsTargetPlatformVersion>10.0.28000.0</WindowsTargetPlatformVersion>
    <TargetName>seat-idd</TargetName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>WindowsUserModeDriver10.0</PlatformToolset>
    <DriverType>UMDF</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <UMDF_VERSION_MAJOR>2</UMDF_VERSION_MAJOR>
    <!-- 2.31 = Windows 10 2004 (19041), the INF floor; iddcx.h 1.4 needs 2.25+ headers. -->
    <UMDF_VERSION_MINOR>31</UMDF_VERSION_MINOR>
    <IndirectDisplayDriver>true</IndirectDisplayDriver>
    <IDDCX_VERSION_MAJOR>1</IDDCX_VERSION_MAJOR>
    <IDDCX_VERSION_MINOR>10</IDDCX_VERSION_MINOR>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
    <SpectreMitigation>Spectre</SpectreMitigation>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- iddcx.h is C++ only. -->
      <CompileAs>CompileAsCpp</CompileAs>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- The remote role uses std::thread / std::mutex. -->
      <ExceptionHandling>Sync</ExceptionHandling>
      <PreprocessorDefinitions>IDDCX_VERSION_MAJOR=1;IDDCX_VERSION_MINOR=10;IDDCX_MINIMUM_VERSION_REQUIRED=4;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ControlFlowGuard>Guard</ControlFlowGuard>
    </ClCompile>
    <Link>
      <!-- The WDK does not add the versioned IddCx stub directory itself. The stub is a WDK
           library: WDKContentRoot, which is the SDK folder with installed kits and the WDK
           package with the NuGet kits (Directory.Build.props). -->
      <AdditionalLibraryDirectories>$([MSBuild]::EnsureTrailingSlash('$(WDKContentRoot)'))Lib\$(TargetPlatformVersion)\um\$(Platform)\iddcx\$(IDDCX_VERSION_MAJOR).$(IDDCX_VERSION_MINOR);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>IddCxStub.lib;d3d11.lib;dxgi.lib;avrt.lib;OneCoreUAP.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalOptions>/INTEGRITYCHECK %(AdditionalOptions)</AdditionalOptions>
      <CETCompat Condition="'$(Platform)'=='x64'">true</CETCompat>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
    <Inf>
      <!-- DriverVer date stays as written in the INF (see seat-input-filter.vcxproj). -->
      <SpecifyDriverVerDirectiveDate>false</SpecifyDriverVerDirectiveDate>
      <TimeStamp>0.1.0.0</TimeStamp>
    </Inf>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\driver.cpp" />
    <ClCompile Include="src\swapchain.cpp" />
    <ClCompile Include="src\roles.cpp" />
    <!-- remote/Driver.cpp and remote/SwapChain.cpp share names with the local role files:
         own object folder. -->
    <ClCompile Include="src\remote\Driver.cpp"><ObjectFileName>$(IntDir)remote\</ObjectFileName></ClCompile>
    <ClCompile Include="src\remote\Adapter.cpp"><ObjectFileName>$(IntDir)remote\</ObjectFileName></ClCompile>
    <ClCompile Include="src\remote\Control.cpp"><ObjectFileName>$(IntDir)remote\</ObjectFileName></ClCompile>
    <ClCompile Include="src\remote\Modes.cpp"><ObjectFileName>$(IntDir)remote\</ObjectFileName></ClCompile>
    <ClCompile Include="src\remote\FrameChannel.cpp"><ObjectFileName>$(IntDir)remote\</ObjectFileName></ClCompile>
    <ClCompile Include="src\remote\SwapChain.cpp"><ObjectFileName>$(IntDir)remote\</ObjectFileName></ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\driver.h" />
    <ClInclude Include="public\seat_idd_ioctl.h" />
    <ClInclude Include="src\roles.h" />
    <ClInclude Include="src\remote\Driver.h" />
    <ClInclude Include="public\PulsarIddShared.h" />
  </ItemGroup>
  <ItemGroup>
    <!-- The driver binary goes into the package dir next to the INF (inf2cat, infverif). -->
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="seat-idd.inf" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
