<!-- Pulsar Seat input filter (KMDF). Needs Visual Studio / Build Tools + the matching WDK.
     Built with WDK 10.0.28000 (unsigned). See README.md. -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7C2B1E4A-9D3F-4B6E-8A15-3F0D2C9E6B71}</ProjectGuid>
    <RootNamespace>seatinput</RootNamespace>
    <!-- WDK 10.0.28000: the first WDK whose MSBuild tasks load in VS 2026 (18). -->
    <WindowsTargetPlatformVersion>10.0.28000.0</WindowsTargetPlatformVersion>
    <TargetName>seatinput</TargetName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <!-- KMDF 1.15 = Windows 10 1507; WdfFdoInitQueryPropertyEx needs 1.13+. -->
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>15</KMDF_VERSION_MINOR>
    <Driver_SpectreMitigation>Spectre</Driver_SpectreMitigation>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <AdditionalIncludeDirectories>$(ProjectDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- NX pool only (HVCI). -->
      <PreprocessorDefinitions>POOL_NX_OPTIN=1;POOL_ZERO_DOWN_LEVEL_SUPPORT=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ControlFlowGuard>Guard</ControlFlowGuard>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(DDK_LIB_PATH)wdmsec.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Signature checked at load; required for HVCI-compatible drivers. -->
      <AdditionalOptions>/INTEGRITYCHECK %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
    <Inf>
      <!-- DriverVer date stays as written in the INF: stampinf's "today" is local time,
           inf2cat checks it against UTC and rejects it as postdated near midnight. -->
      <SpecifyDriverVerDirectiveDate>false</SpecifyDriverVerDirectiveDate>
      <TimeStamp>0.1.0.0</TimeStamp>
    </Inf>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="include\seatinput_ioctl.h" />
    <ClInclude Include="src\seatinput.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\driver.c" />
    <ClCompile Include="src\control.c" />
    <ClCompile Include="src\kbdmou.c" />
    <ClCompile Include="src\hid.c" />
  </ItemGroup>
  <ItemGroup>
    <!-- The driver binary goes into the package dir next to the INF (inf2cat, infverif). -->
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="seat-input-filter.inf" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
